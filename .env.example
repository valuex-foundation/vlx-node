# Copy manually to .env. Never publish .env.
# Local Compose build version. Keep aligned with the CI pin in versions.env.
AVALANCHEGO_VERSION=v1.15.0
NETWORK_ID=1
SUBNET_ID=2o1i2YzX4FVfAzNHJYUnt4YFALuZNJGUvJS2nhx1zTTiGWUnZv
# Avalanche network ID above is NOT EVM Chain ID 90000.
PUBLIC_IP=
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,vlx-node
HTTP_ALLOWED_ORIGINS=http://localhost
# Absolute paths recommended. Existing deployments: review before changing.
DATA_DIR=./data
STAKING_DIR=./staking
PROMETHEUS_RETENTION=15d
# Set before enabling monitoring; no default password.
GRAFANA_ADMIN_PASSWORD=
