# Install inside nginx http{} (sites-enabled on Ubuntu, conf.d on Rocky).
# Replace rpc.example.com and certificate paths before nginx -t.
limit_req_zone $binary_remote_addr zone=vlx_rpc:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=vlx_conn:10m;
server {
    listen 443 ssl;
    server_name rpc.example.com;
    ssl_certificate /etc/letsencrypt/live/rpc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rpc.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 10s;
    location = /rpc {
        limit_except POST { deny all; }
        limit_req zone=vlx_rpc burst=20 nodelay;
        limit_conn vlx_conn 10;
        proxy_pass http://127.0.0.1:9652/rpc;
        proxy_set_header Host localhost;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
